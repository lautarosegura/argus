{
  "name": "argus",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sandcastle": "npx tsx .sandcastle/main.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gui": "NODE_OPTIONS='--import tsx' npx electron gui/main.ts",
    "gui:open": "NODE_OPTIONS='--import tsx' npx electron gui/main.ts --workspace"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.8",
    "@types/node": "^22.0.0",
    "electron": "^42.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
